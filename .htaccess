<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Redirect /index.html -> /
    RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
    RewriteRule ^index\.html$ / [R=301,L]

    # 301 Redirect nested service & tutor subdirectories directly to flat root URLs
    RewriteRule ^services/(.+?)(\.html)?$ /$1 [R=301,L,NC]
    RewriteRule ^tutors/(.+?)(\.html)?$ /$1 [R=301,L,NC]
    RewriteRule ^services/?$ /#featured-courses [R=301,L,NC]
    RewriteRule ^tutors/?$ /female-tutors [R=301,L,NC]
    RewriteRule ^services_(.+?)(\.html)?$ /$1 [R=301,L,NC]
    RewriteRule ^tutors_(.+?)(\.html)?$ /$1 [R=301,L,NC]

    # Redirect old .html URLs -> extensionless URLs
    RewriteCond %{THE_REQUEST} \s/+(.+)\.html[\s?] [NC]
    RewriteRule ^(.+)\.html$ /$1 [R=301,L]

    # Redirect nested thank-you.html from subdirectories (e.g. /services/thank-you.html) to root
    RewriteRule ^.*/thank-you$ /thank-you [R=301,L]

    # Internally serve extensionless URLs from .html files
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.+)$ $1.html [L,QSA]
</IfModule>

# ============================================================
# PUBLIC: robots.txt and llms.txt
# MUST be accessible to search engines, AI models, and browsers.
# ============================================================
<FilesMatch "^(robots|llms)\.txt$">
    Require all granted
</FilesMatch>

# ============================================================
# PROTECT DEVELOPMENT / SENSITIVE FILES
# robots.txt and llms.txt are excluded because they are public.
# ============================================================
<FilesMatch "\.(py|md|log|sh|bat)$">
    Require all denied
</FilesMatch>

# Protect other .txt files except robots.txt and llms.txt
<FilesMatch "^(?!(robots|llms)\.txt$).+\.txt$">
    Require all denied
</FilesMatch>

# Block sensitive directories
RedirectMatch 404 ^/\.git(/|$)
RedirectMatch 404 ^/backup(/|$)
RedirectMatch 404 ^/scratch(/|$)

# ============================================================
# CACHE
# ============================================================
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|woff2|woff|ttf|svg|webp|avif|jpg|jpeg|png)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>

    <FilesMatch "\.(html|htm)$">
        Header set X-Robots-Tag "index, follow"
    </FilesMatch>

    <Files "robots.txt">
        Header set Cache-Control "public, max-age=3600"
    </Files>
</IfModule>


# Protect Storage Files
<FilesMatch "^(users\.json|leads\.jsonl)$|\.(sqlite|jsonl)$">
    Require all denied
</FilesMatch>

# Block access to data directories
RedirectMatch 404 ^/(api/data|admin/data)(/|$)
