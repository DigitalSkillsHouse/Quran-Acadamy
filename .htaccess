<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Redirect /index.html -> /
    RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
    RewriteRule ^index\.html$ / [R=301,L]

    # Redirect old .html URLs -> extensionless URLs
    RewriteCond %{THE_REQUEST} \s/+(.+)\.html[\s?] [NC]
    RewriteRule ^(.+)\.html$ /$1 [R=301,L]

    # Internally serve extensionless URLs from .html files
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.+)$ $1.html [L,QSA]
</IfModule>

# ============================================================
# PUBLIC: robots.txt
# MUST be accessible to search engines and browsers.
# ============================================================
<Files "robots.txt">
    Require all granted
</Files>

# ============================================================
# PROTECT DEVELOPMENT / SENSITIVE FILES
# robots.txt is excluded because it is explicitly public above.
# ============================================================
<FilesMatch "\.(py|md|log|sh|bat)$">
    Require all denied
</FilesMatch>

# Protect other .txt files except robots.txt
<FilesMatch "^(?!robots\.txt$).+\.txt$">
    Require all denied
</FilesMatch>

# Block sensitive directories
RedirectMatch 404 ^/\.git(/|$)
RedirectMatch 404 ^/backup(/|$)
RedirectMatch 404 ^/scratch(/|$)

# ============================================================
# CACHE
# ============================================================
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|woff2|woff|ttf|svg|webp|avif|jpg|jpeg|png)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>

    <FilesMatch "\.(html|htm)$">
        Header set X-Robots-Tag "index, follow"
    </FilesMatch>

    <Files "robots.txt">
        Header set Cache-Control "public, max-age=3600"
    </Files>
</IfModule>
